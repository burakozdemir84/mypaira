# NOTE: Cloudflare Pages applies EVERY matching rule cumulatively, not just the
# most specific one. So Cache-Control is set only on /assets/* here — putting it
# on /* as well would concatenate both values into one contradictory header.

# Images are cached for 30 days. Not "immutable": the filenames are not
# content-hashed, so a replaced image still has to reach visitors.
# To make a swapped image live immediately, change its filename.
/assets/*
  Cache-Control: public, max-age=2592000

/support.js
  Cache-Control: public, max-age=86400

# Security headers for every response. HTML deliberately has no Cache-Control
# here, so it keeps the Pages default (revalidate on each request) and content
# edits go live on deploy.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
/mail/legal-in-the-loop/*.ics
  Content-Type: text/calendar; charset=utf-8

# Calendar files for webinar invitations (Apple "add to calendar" buttons)
/webinar/*
  Content-Type: text/calendar; charset=utf-8

# Pre-meeting discovery form (invite-only). Not indexed, never cached, no
# Referer leaves the page, and it cannot be framed. The invite token lives in
# the URL fragment, which browsers never send to the server.
/on-hazirlik
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
/on-hazirlik.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/on-hazirlik-yonetim
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
/on-hazirlik-yonetim.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cache-Control: no-store
/api/discovery/*
  X-Robots-Tag: noindex, nofollow
/assets/nda/*
  X-Robots-Tag: noindex, nofollow
